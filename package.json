{
  "name": "spar-networking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test scripts/*.test.mjs",
    "import:slack": "node scripts/import-slack.mjs",
    "deploy": "sst deploy --stage production",
    "sst:dev": "sst dev --stage e2e --mode mono",
    "sync:slack": "node scripts/sync-slack.mjs",
    "format": "prettier --write src scripts sst.config.ts vite.config.ts"
  },
  "dependencies": {
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "@tabler/icons-react": "^3.34.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.18",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.6",
    "sst": "^4.17.1",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
